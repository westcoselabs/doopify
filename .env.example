# Doopify — copy to .env and replace the required placeholders.
# Keep real values out of Git. Vercel uses project Environment Variables.
# .env.local is optional: use it only for intentional local overrides/tests.
# Reference: docs/ENVIRONMENT_VARIABLE_REFERENCE.md

# Required application configuration
DATABASE_URL="postgresql://doopify_user:replace_me@localhost:5432/doopify_dev?schema=public"
JWT_SECRET="replace_with_a_random_secret_at_least_32_chars"
DATA_ENCRYPTION_KEY="replace_with_a_random_secret_at_least_32_chars"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
# Hosted Postgres: use sslmode=verify-full and the host's connection URL.
# Existing stores: copy the SAME ENCRYPTION_KEY value to DATA_ENCRYPTION_KEY.
# Never generate a replacement during this rename: MFA/downloads need the old value.
# Fresh installations only: generate each secret separately with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Stripe — required for checkout; matching test keys for development
STRIPE_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Signing secret for this environment's /api/webhooks/stripe endpoint.

# Background processing — one shared runner credential is enough for a new store
WEBHOOK_RETRY_SECRET="replace_with_a_random_secret_at_least_16_chars"
# Optional separate credentials; preserve existing values if schedulers use them:
# JOB_RUNNER_SECRET="your_existing_jobs_credential"
# ABANDONED_CHECKOUT_SECRET="your_existing_recovery_credential"

# Select only the providers you use. Business settings remain in admin.
EMAIL_PROVIDER="none"
SHIPPING_RATE_PROVIDER="none"
SHIPPING_LABEL_PROVIDER="none"
MEDIA_STORAGE_PROVIDER="postgres"
# Email: none | resend | smtp | preview (development only; never marks mail sent).
# Shipping: none | shippo | easypost, independently for rates and labels.
# Storage: postgres | vercel-blob | s3.

# Email option A — set EMAIL_PROVIDER=resend
# RESEND_API_KEY="re_replace_me"
# RESEND_WEBHOOK_SECRET="whsec_replace_me"
# Register /api/webhooks/email-provider for email.bounced/email.complained.

# Email option B — set EMAIL_PROVIDER=smtp
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USERNAME="smtp-user"
# SMTP_PASSWORD="replace_me"
# SMTP_FROM_EMAIL="noreply@example.com"
# Port/security default to 587/false. Sender identity/templates are admin settings.

# Shipping — uncomment only the selected provider
# SHIPPO_API_KEY="shippo_test_replace_me"
# SHIPPO_WEBHOOK_SECRET="replace_me"
# EASYPOST_API_KEY="EZTK_replace_me"
# EASYPOST_WEBHOOK_SECRET="replace_me"

# Public media on Vercel — set MEDIA_STORAGE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
# Blob is for public product/gallery images, not private digital downloads.

# S3/R2 — set MEDIA_STORAGE_PROVIDER=s3
# MEDIA_S3_REGION="auto"
# MEDIA_S3_BUCKET="your-bucket"
# MEDIA_S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
# MEDIA_S3_ACCESS_KEY_ID="replace_me"
# MEDIA_S3_SECRET_ACCESS_KEY="replace_me"
# MEDIA_PUBLIC_BASE_URL="https://your-cdn.example.com"
# Optional private local download directory: DIGITAL_ASSET_LOCAL_DIR

# First owner in production only; remove after creating the owner
# SETUP_TOKEN="replace_with_a_random_bootstrap_token"

# Temporary migration/rotation settings — omit unless actively needed
# DATA_ENCRYPTION_KEY_PREVIOUS="existing_previous_key_until_rotation_finishes"
# SESSION_LEGACY_TOKEN_CUTOFF="2030-01-08T12:00:00.000Z"
# Set the cutoff once during a legacy-session migration; never extend it casually.

# Local tests only — put in .env.local; never target a live store
# DATABASE_URL_TEST="postgresql://doopify_test:replace_me@localhost:5432/doopify_test?schema=integration"
# E2E_DATABASE_URL is only needed for an explicitly acknowledged public-schema reset.

# Optional outbound hooks: define destinations in src/server/config/outbound-webhooks.ts.
# OUTBOUND_WEBHOOK_FULFILLMENT_SIGNING_KEY="replace_with_a_unique_random_secret"
# Bootstrap CLI helpers, worker options, CSP and deployment tooling:
# see docs/ENVIRONMENT_VARIABLE_REFERENCE.md; they are not baseline runtime requirements.
